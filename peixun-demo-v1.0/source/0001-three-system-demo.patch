+        <p>备件到货 T+{{ run.eta }} min</p>
+      </div>
+      <div class="metric">
+        <span>已完成工序</span
+        ><b
+          >{{ finished }}<small>/ {{ spans.length }}</small></b
+        >
+        <p>{{ run.planVersion }} · 独立资源与账本</p>
