+);
+async function start() {
+  const r = await command(
+    "training.start",
+    {
+      assignmentId: startAssignment.value.id,
+      mode: mode.value,
+      scope: scope.value,
+    },
+    "训练会话已开始",
+  );
+  if (r) {
+    store.selectedAttempt = r.id;
+    startAssignment.value = null;
+    router.push(pathFor("C05", r.id));
