+        ObjectNode derived = a.deepCopy();
+        derived
+            .put("id", id("ASSET"))
+            .put("parentId", target)
+            .put("version", a.path("version").asInt() + 1)
+            .put("status", "PROCESSING")
+            .put("name", a.path("name").asText() + " · 派生")
+            .put("owner", actor);
+        derived.set(
+            "processParameters",
+            obj(
